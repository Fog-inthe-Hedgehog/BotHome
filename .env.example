# Docker image tag (used by docker compose: bot-home:${TAG})
TAG=latest

# Debug logging (true/false)
DEBUG=false

# Telegram bot token
TELEGRAM_BOT_TOKEN=

# API credentials from https://my.telegram.org (required for MTProto)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# MTProto proxy — полная ссылка из Telegram (secret целиком, без * и пробелов)
# Длина secret: 34 символа (ee+32hex) или ~48 (ee+домен/fake-TLS) — оба варианта OK
TELEGRAM_PROXY=tg://proxy?server=95.164.92.143&port=8444&secret=ee3f92b742...

# Для secret с префиксом ee: intermediate (по умолчанию)
TELEGRAM_MTPROTO_MODE=intermediate

# Chat ID для уведомлений
ADMIN_ID=

# RSS источник
RSS_URL=https://konkretnye-novosti.ru/news/rss/

# Интервал проверки RSS в часах
CHECK_INTERVAL_HOURS=24

# Ключевые слова для фильтрации через запятую
RSS_KEYWORDS=Улица, Район, Микрорайон, Микроулица
